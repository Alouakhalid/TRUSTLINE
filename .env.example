# ==========================================
# TRUSTLINE - System Environment Variables
# Team NEBUVITA | NASA Space Health Initiative
# ==========================================

# --- System & Deployment ---
NODE_ENV=development
ENVIRONMENT=local
LOG_LEVEL=INFO
SECRET_KEY=change_me_to_a_secure_random_key_in_production

# --- Hybrid AI Engine Router ---
# Modes: LOCAL (Spacecraft Offline Mode), CLOUD (Deep Space Network Earth Sync), HYBRID (Dynamic Latency-based Routing)
AI_ROUTER_MODE=HYBRID
LOCAL_AI_ENDPOINT=http://localhost:11434/v1
LOCAL_AI_MODEL=mistral-7b-instruct
CLOUD_AI_PROVIDER=openai
CLOUD_AI_API_KEY=your_cloud_ai_api_key_here
CLOUD_AI_MODEL=gpt-4o

# --- Telemetry & Sensor Simulator ---
ASTRONAUT_TELEMETRY_FREQ_HZ=10
SIMULATOR_ENABLE_ANOMALIES=true
SIMULATOR_MISSION_PROFILE=ARTEMIS_DEEP_SPACE

# --- Backend API & WebSockets ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# --- Database & Storage ---
# Offline Local Postgres (Spacecraft Edge)
LOCAL_POSTGRES_HOST=localhost
LOCAL_POSTGRES_PORT=5432
LOCAL_POSTGRES_DB=trustline_edge
LOCAL_POSTGRES_USER=nebuvita_admin
LOCAL_POSTGRES_PASSWORD=secure_space_password

# Supabase (Mission Control / Ground Station Sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry
